print("ALGEBRA AND CALCULUS 1 - USING MATH MODULE")
print("""
     1. Solve a linear equation (ax + b = c)
     2. Solve a quadratic equation (ax^2 + bx + c = 0)
     3. Evaluate f(x) = ax^2 + bx + c
     4. Find the derivative f(x) at a point
     5. Estimate a limit as a x approaches a value
     6. Compute a definite integral of f(x)
     7. Quit
""")
choice = input("Enter your choice: ").strip()

if choice == "1":
  a = int(input("Enter the value of a: "))
  b = int(input("Enter the value of b: "))
  c = int(input("Enter the value of c: "))
  print((c-b)/a)

elif choice == "2":
  a = int(input("Enter the value of a: "))
  b = int(input("Enter the value of b: "))
  c = int(input("Enter the value of c: "))
  print("The positive x of quadratic is: ")
  print((-b+(b**2)-4*a*c)**0.5/2*a)
  print("The negative x of quadratic is: ")
  print((-b-(b**2)-4*a*c)**0.5/2*a)

elif choice == "3":
  a = int(input("Enter the value of a: "))
  b = int(input("Enter the value of b: "))
  c = int(input("Enter the value of c: "))
  x = int(input("Enter the value of x in f(x): "))
  print("the f(x) is: ")
  print(a*(x**2)+b*x+c)

elif choice == "4":
  a = int(input("Enter a value of coefficient: "))
  b = int(input("Enter a value of exponent: "))
  if b == "1":
    print("the derivative entered is:")
    print(a)
  else: 
    print("the derivative entered is: ")
    print((a*b),"x","^",(b-1))

elif choice == "5":
  a = float(input("Enter the value of a: "))
  b = float(input("Enter the value of b: "))
  c = float(input("Enter the value of c: "))
  x = float(input("Enter the value of x: "))
  f = lambda t: a * (t**2) + b * t + c
  print("Left-hand Limit: ", f(x - 0.0001))
  print("Right-hand Limit: ", f(x + 0.0001))
  print("True Limit: ", f(x))

elif choice == "6":
  a = int(input("Enter a value of coefficient: "))
  b = int(input("Enter a value of exponent: "))
  print("The definite integral of f(x) is: ")
  print(a/(b+1),"x","^",(b+1),"+ C")
  
elif choice == "7":
  print("Thanks for using the math module.")

else:
  print("Invalid choice. Enter the numbers 1-7 only.")


  
